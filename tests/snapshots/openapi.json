            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Saúde da API",
        "tags": [
          "Sistema"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Verifica o provedor de IA configurado. Sem provedor registrado (fase de fundação), responde `200`.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Prontidão da API",
        "tags": [
          "Sistema"
        ]
      }
    }
  }
}
