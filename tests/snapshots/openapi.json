{
  "components": {
    "schemas": {
      "AiStatusResponse": {
        "type": "object",
        "description": "Corpo de GET /admin/ai/status (nunca exp\u00f5e chaves).",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "description": "Nome do provedor no registry."
                },
                "label": {
                  "type": "string",
                  "description": "R\u00f3tulo humano do provedor."
                },
                "default_model": {
                  "type": "string",
                  "description": "Modelo padr\u00e3o do provedor."
                },
                "available": {
                  "type": "boolean",
                  "description": "Resultado da \u00faltima verifica\u00e7\u00e3o de sa\u00fade."
                },
                "checked_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Instante da verifica\u00e7\u00e3o, em UTC."
                },
                "error": {
                  "type": "string",
                  "description": "C\u00f3digo do erro, quando indispon\u00edvel."
                }
              },
              "required": [
                "provider",
                "label",
                "default_model",
                "available",
                "checked_at"
              ]
            },
            "description": "Status de cada provedor habilitado."
          }
        },
        "required": [
          "providers"
        ]
      },
      "AssistantMessage": {
        "additionalProperties": false,
        "description": "Mensagem de resposta do assistente.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "role": {
            "const": "assistant",
            "default": "assistant",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "AssistantMessage",
        "type": "object"
      },
      "ChatMessageInput": {
        "additionalProperties": false,
        "description": "Mensagem enviada pelo cliente.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessageInput",
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "description": "Corpo de `POST /chat` (sem `system_prompt` nem par\u00c3\u00a2metros de gera\u00c3\u00a7\u00c3\u00a3o).",
        "example": {
          "messages": [
            {
              "content": "Explique SSE em uma frase.",
              "role": "user"
            }
          ],
          "model": "llama3.1:latest",
          "stream": false
        },
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageInput"
            },
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Modelo instalado no Ollama para esta requisi\u00c3\u00a7\u00c3\u00a3o. Omitido, usa o modelo padr\u00c3\u00a3o do servidor (`OLLAMA_MODEL`).",
            "title": "Model"
          },
          "stream": {
            "default": true,
            "title": "Stream",
            "type": "boolean"
          }
        },
        "required": [
          "messages"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "additionalProperties": false,
        "description": "Resposta completa do chat (`stream = false`).",
        "example": {
          "finish_reason": "stop",
          "message": {
            "content": "SSE envia eventos incrementais.",
            "role": "assistant"
          },
          "model": "llama3.1",
          "provider": "ollama",
          "usage": {
            "daily_limit": 10,
            "daily_remaining": 9,
            "per_minute_limit": 3,
            "per_minute_remaining": 2,
            "resets_at": "2026-10-29T00:00:00Z"
          }
        },
        "properties": {
          "finish_reason": {
            "enum": [
              "stop",
              "length",
              "timeout"
            ],
            "title": "Finish Reason",
            "type": "string"
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageInfo"
          }
        },
        "required": [
          "message",
          "provider",
          "model",
          "finish_reason",
          "usage"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
