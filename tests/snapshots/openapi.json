              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "JWT emitido por `/api/v1/auth/login` ou `/api/v1/auth/guest`.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "API do chat de IA via web, conforme o SRS v2.0.\n\n- Autentica\u00e7\u00e3o por JWT (\u0007dmin e guest).\n- Chat com resposta JSON ou streaming SSE.\n- Gateway multi-provedor (Ollama, OpenAI, Anthropic, Gemini e OpenAI-compatible).\n- Cat\u00e1logo agregado de modelos (/models) e sele\u00e7\u00e3o por Model ID.\n- Camadas de compatibilidade OpenAI, Anthropic (Claude Code) e Ollama.\n- Cotas em mem\u00f3ria por convidado e por IP.\n- Administra\u00e7\u00e3o: estat\u00edsticas, status dos provedores, guests e reset de cota.\n- Erros no padr\u00e3o Problem Details (\u0007pplication/problem+json).",
    "title": "Nexa API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/ai/status": {
      "get": {
        "description": "Informa provedor, modelo e disponibilidade. Chaves e segredos nunca s\u00c3\u00a3o expostos.",
        "operationId": "ai_status_api_v1_admin_ai_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Token ausente ou inv\u00c3\u00a1lido."
          },
          "403": {
            "description": "Requer papel `admin`."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Status do provedor de IA",
        "tags": [
          "Administra\u00c3\u00a7\u00c3\u00a3o"
        ]
      }
    },
    "/api/v1/admin/guests": {
      "get": {
        "description": "Lista os guests conhecidos em mem\u00c3\u00b3ria (para obter o `gid` usado no reset) e o uso di\u00c3\u00a1rio agregado por IP.",
        "operationId": "list_guests_api_v1_admin_guests_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Token ausente ou inv\u00c3\u00a1lido."
          },
          "403": {
            "description": "Requer papel `admin`."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Guests ativos e uso por IP",
        "tags": [
          "Administra\u00c3\u00a7\u00c3\u00a3o"
        ]
      }
    },
    "/api/v1/admin/stats": {
      "get": {
        "description": "Contadores em mem\u00c3\u00b3ria desde a \u00c3\u00baltima inicializa\u00c3\u00a7\u00c3\u00a3o: requisi\u00c3\u00a7\u00c3\u00b5es de chat, guests distintos, barrados por limite, erros do provedor e dura\u00c3\u00a7\u00c3\u00a3o m\u00c3\u00a9dia.",
        "operationId": "get_stats_api_v1_admin_stats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Token ausente ou inv\u00c3\u00a1lido."
          },
          "403": {
            "description": "Requer papel `admin`."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Estat\u00c3\u00adsticas de uso",
        "tags": [
          "Administra\u00c3\u00a7\u00c3\u00a3o"
        ]
      }
    },
    "/api/v1/admin/usage/reset": {
      "post": {
        "description": "Zera a cota di\u00c3\u00a1ria do `gid` ou do IP informado. Alvo inexistente retorna `404` (`not_found`).",
        "operationId": "reset_usage_api_v1_admin_usage_reset_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Cota zerada."
          },
          "401": {
            "description": "Token ausente ou inv\u00c3\u00a1lido."
          },
          "403": {
            "description": "Requer papel `admin`."
          },
          "404": {
            "description": "`gid` ou IP sem cota ativa."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Zera a cota de um guest ou IP",
        "tags": [
          "Administra\u00c3\u00a7\u00c3\u00a3o"
        ]
      }
    },
    "/api/v1/auth/guest": {
      "post": {
        "description": "Cria um `gid` (UUID v4) e devolve um token com papel `guest` e o uso inicial. A emiss\u00c3\u00a3o \u00c3\u00a9 limitada por IP.",
        "operationId": "guest_token_api_v1_auth_guest_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "429": {
            "description": "Limite de emiss\u00c3\u00a3o por IP excedido."
          }
        },
        "summary": "Emite token de convidado",
        "tags": [
          "Autentica\u00c3\u00a7\u00c3\u00a3o"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Valida usu\u00c3\u00a1rio e senha e devolve um access token JWT.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Credenciais inv\u00c3\u00a1lidas."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Login temporariamente bloqueado."
          }
        },
        "summary": "Login do administrador",
        "tags": [
          "Autentica\u00c3\u00a7\u00c3\u00a3o"
        ]
      }
    },
    "/api/v1/chat": {
      "post": {
        "description": "Recebe o contexto completo e devolve a resposta do modelo. Com `stream = false` a resposta \u00c3\u00a9 um JSON completo; com `stream = true` (padr\u00c3\u00a3o) a resposta \u00c3\u00a9 um fluxo SSE com `data:` por trecho, evento `done` no fim e evento `error` em falhas ap\u00c3\u00b3s o in\u00c3\u00adcio (3.7.3).",
        "operationId": "chat_api_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              },
              "text/event-stream": {
                "example": "data: {\"content\":\"SSE \u00c3\u00a9 \"}\n\nevent: done\ndata: {\"status\":\"complete\",\"finish_reason\":\"stop\",\"usage\":{\"daily_limit\":10,\"daily_remaining\":6,\"per_minute_limit\":3,\"per_minute_remaining\":2,\"resets_at\":\"2026-10-29T00:00:00Z\"}}\n\n",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Resposta JSON (`stream = false`) ou fluxo SSE (`stream = true`)."
          },
          "401": {
            "description": "Token ausente ou inv\u00c3\u00a1lido."
          },
          "422": {
            "description": "Contexto inv\u00c3\u00a1lido ou acima dos limites do papel."
          },
          "429": {
            "description": "Cota ou limite por minuto excedido."
          },
          "502": {
            "description": "Erro do provedor de IA."
          },
          "504": {
            "description": "Timeout do provedor de IA."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Envia mensagens ao provedor de IA",
        "tags": [
          "Chat"
        ]
      }
    },
    "/api/v1/models": {
      "get": {
        "description": "Consulta o provedor de IA (Ollama) e devolve os modelos locais instalados, com nome, tamanho, data de modifica\u00c3\u00a7\u00c3\u00a3o, fam\u00c3\u00adlia, par\u00c3\u00a2metros e quantiza\u00c3\u00a7\u00c3\u00a3o. `default_model` \u00c3\u00a9 o modelo usado quando o chat omite `model`; `selectable` indica se o modelo pode ser escolhido no chat (respeita `AI_ALLOWED_MODELS`).",
        "operationId": "list_models_api_v1_models_get",
        "parameters": [
          {
            "description": "Ignora o cache curto e consulta o provedor novamente.",
            "in": "query",
            "name": "refresh",
            "required": false,
            "schema": {
              "default": false,
              "description": "Ignora o cache curto e consulta o provedor novamente.",
              "title": "Refresh",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Token ausente ou inv\u00c3\u00a1lido."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "description": "Resposta inv\u00c3\u00a1lida do provedor."
          },
          "503": {
            "description": "Provedor de IA indispon\u00c3\u00advel."
          },
          "504": {
            "description": "Provedor de IA n\u00c3\u00a3o respondeu a tempo."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Lista os modelos instalados",
        "tags": [
          "Modelos"
        ]
      }
    },
    "/api/v1/usage": {
      "get": {
        "description": "Retorna a cota di\u00c3\u00a1ria (apenas guest), o limite por minuto e o uso restante do chamador. Para o admin, os campos di\u00c3\u00a1rios s\u00c3\u00a3o `null`.",
        "operationId": "get_usage_api_v1_usage_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Token ausente ou inv\u00c3\u00a1lido."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Limites e uso restante",
        "tags": [
          "Uso"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Indica que o processo est\u00c3\u00a1 no ar. P\u00c3\u00bablico e sem depend\u00c3\u00aancias externas.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Sa\u00c3\u00bade da API",
        "tags": [
          "Sistema"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Verifica o provedor de IA configurado. Sem provedor registrado (fase de funda\u00c3\u00a7\u00c3\u00a3o), responde `200`.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Prontid\u00c3\u00a3o da API",
        "tags": [
          "Sistema"
        ]
      }
    }
  }
}