# ---------------------------------------------------------------------------
# Nexa API - exemplo de configuração (12-factor / RNF-POR-02)
# Copie para .env e ajuste. NUNCA versione o .env.
#
# Organização:
#   1. Núcleo, segurança e limites ......... lidos pela API v1.1.0
#   2. Provedor de IA (v1.1.0) ............ lidos pela API v1.1.0
#   3. Gateway multi-provedor (v2.0) ...... planejado (fases F12-F17)
#   4. SQLite de usuários (v2.0) .......... planejado (fase F13)
#   5. Compatibilidade externa (v2.0) ..... planejado (fases F14-F16)
#
# As seções marcadas como "v2.0 (planejado)" NÃO são lidas pela API atual
# (1.1.0): `Settings` ignora variáveis desconhecidas. Elas existem para
# documentar o contrato da v2.0 (SRS v2.0, §3.1.4) e evitar divergência
# quando as fases F12-F17 forem implementadas.
# ---------------------------------------------------------------------------

# ===========================================================================
# 1. NÚCLEO, SEGURANÇA E LIMITES (v1.1.0)
# ===========================================================================

# Ambiente: development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Autenticação do administrador (obrigatório) ---------------------------
ADMIN_USERNAME=admin
# Hash argon2id ou bcrypt. Gere com: python scripts/hash_password.py "sua-senha"
# O valor abaixo corresponde à senha "admin" e serve APENAS para desenvolvimento.
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$KMwCxpCk5TYd4cdcRrnSFA$QKtV/j4myVFG6IfaM7tR6yZnx4KqRu4Q+PtQA958h48
# Em produção: no mínimo 32 bytes de entropia e nunca um valor de exemplo.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes-ou-mais
JWT_ALGORITHM=HS256
ADMIN_TOKEN_EXPIRE_MINUTES=60

# --- Convidados (guest) -----------------------------------------------------
GUEST_TOKEN_EXPIRE_HOURS=24
GUEST_DAILY_MESSAGES=10
GUEST_RATE_PER_MIN=3
GUEST_MAX_MESSAGES_PER_REQUEST=20
GUEST_MAX_MESSAGE_CHARS=2000
GUEST_IP_DAILY_MESSAGES=30
GUEST_TOKENS_PER_IP_PER_HOUR=10

# --- Limites do administrador ----------------------------------------------
RATE_LIMIT_ADMIN_CHAT_PER_MIN=60
MAX_MESSAGES_PER_REQUEST=100
MAX_MESSAGE_CHARS=8000
ALLOW_CLIENT_SYSTEM_MESSAGES=false
DEFAULT_SYSTEM_PROMPT=

# --- Segurança / entrada ----------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MAX_REQUEST_BODY_BYTES=2097152
# CIDRs de proxies confiáveis para ler X-Forwarded-For (vazio = não confiar)
TRUSTED_PROXIES=
CORS_ORIGINS=http://localhost:5173
UVICORN_WORKERS=1
# Prazo máximo do graceful shutdown (SIGTERM), em segundos (RNF-CON-04)
SHUTDOWN_TIMEOUT_SECONDS=30

# ===========================================================================
# 2. PROVEDOR DE IA (v1.1.0)
# ===========================================================================
# A v1.1.0 fala com um único provedor Ollama. Na v2.0 este bloco é
# substituído pelo gateway abaixo; `AI_PROVIDER` e `CLOUD_*` serão
# descontinuados (ver seção 3).

AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Descontinuados na v2.0 — mantidos apenas para compatibilidade de leitura.
# AI_PROVIDER=cloud exige CLOUD_PROVIDER e CLOUD_MODEL (senão o boot falha).
CLOUD_PROVIDER=
CLOUD_BASE_URL=
CLOUD_MODEL=
CLOUD_API_KEY=

AI_TIMEOUT_SECONDS=120
AI_STREAM_IDLE_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_OUTPUT_SECONDS=300
# Modelos que o cliente pode escolher (vazio = todos os instalados).
# v2.0: allowlist de Model IDs `provider/model` com globs.
AI_ALLOWED_MODELS=
# TTL do cache do catálogo de modelos em segundos (0 desativa)
MODELS_CACHE_SECONDS=10

# --- Redis (opcional; obrigatório se UVICORN_WORKERS > 1) -------------------
REDIS_URL=

# ===========================================================================
# 3. GATEWAY MULTI-PROVEDOR (v2.0 — planejado, fase F12)
# ===========================================================================
# Model ID canônico: `provider/model` (ex.: `anthropic/claude-sonnet-4-5`).
# Nome sem prefixo resolve para AI_DEFAULT_MODEL ou para um alias.
# Ver docs/provedores-ia.md.

# Variáveis compartilhadas com a v1.1.0 (definidas na seção 2 e reutilizadas
# aqui, sem duplicar a chave): OLLAMA_URL, OLLAMA_MODEL, AI_TIMEOUT_SECONDS,
# AI_STREAM_IDLE_TIMEOUT_SECONDS, AI_MAX_OUTPUT_TOKENS, AI_MAX_OUTPUT_SECONDS,
# AI_ALLOWED_MODELS, MODELS_CACHE_SECONDS.

# Modelo padrão quando o chat omite `model`.
AI_DEFAULT_MODEL=ollama/llama3.1
# Aliases em JSON: {"fast":"ollama/llama3.1","smart":"anthropic/claude-sonnet-4-5"}
AI_MODEL_ALIASES=
# Model IDs tentados apenas ANTES do primeiro token (vazio = sem fallback).
AI_FALLBACK_CHAIN=
# Provedores habilitados; vazio = autodetectar por credencial.
# Valores: ollama, ollama_cloud, openai, anthropic, google, openai_compatible
AI_ENABLED_PROVIDERS=ollama
# Tentativas de fallback antes do primeiro token.
AI_MAX_RETRIES=1

# --- Ollama local -----------------------------------------------------------
# OLLAMA_URL e OLLAMA_MODEL vêm da seção 2.
# Opcional: chave para um Ollama protegido por proxy.
OLLAMA_API_KEY=

# --- Ollama Cloud -----------------------------------------------------------
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_DEFAULT_MODEL=qwen3-coder:480b

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
# Opcional, quando o provedor exigir organização.
OPENAI_ORG_ID=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5

# --- Google Gemini ----------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash

# --- OpenAI-compatible (Groq, OpenRouter, vLLM, LM Studio, Azure...) --------
OPENAI_COMPAT_NAME=groq
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_DEFAULT_MODEL=

# ===========================================================================
# 4. SQLITE DE USUÁRIOS (v2.0 — planejado, fase F13)
# ===========================================================================
# O SQLite guarda SOMENTE usuários (ADMIN permanente + usuários de teste) e o
# controle de migrações. Nenhum conteúdo de chat é persistido.
# Ver docs/database-sqlite.md.

# Apenas `sqlite:///` é aceito.
DATABASE_URL=sqlite:///./data/nexa.db

# --- PRAGMAs e conexão ------------------------------------------------------
SQLITE_WAL=true
# NORMAL (recomendado) | FULL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_BUSY_TIMEOUT_MS=5000
# Cache de páginas em KB (65536 = 64 MB).
SQLITE_CACHE_SIZE_KB=65536
# Tamanho do mmap em bytes (268435456 = 256 MB).
SQLITE_MMAP_BYTES=268435456
SQLITE_READ_POOL_SIZE=4

# --- Cache de autenticação --------------------------------------------------
USERS_CACHE_TTL_SECONDS=30
USERS_CACHE_MAX_ENTRIES=10000

# --- Usuários de teste ------------------------------------------------------
ALLOW_TEST_USERS=true
TEST_USER_DEFAULT_DAILY_MESSAGES=100
TEST_USER_DEFAULT_RATE_PER_MIN=10
# Expiração padrão em horas (0 = sem expiração).
TEST_USER_TTL_HOURS=168
TEST_USER_MAX_BULK=100

# --- Manutenção -------------------------------------------------------------
DB_BACKUP_BEFORE_MIGRATION=true
DB_BACKUP_DIR=./data/backups
# quick | full | off
DB_STARTUP_CHECK=quick
DB_OPTIMIZE_ON_SHUTDOWN=true

# ===========================================================================
# 5. COMPATIBILIDADE COM APIs EXTERNAS (v2.0 — planejado, fases F14-F16)
# ===========================================================================
# Expõe a NEXA API como se fosse OpenAI (/v1), Anthropic (/v1/messages) e
# Ollama (/api). Ver docs/compatibilidade-apis-externas.md.

COMPAT_OPENAI_ENABLED=true
COMPAT_ANTHROPIC_ENABLED=true
COMPAT_OLLAMA_ENABLED=true

# Chaves `nxa_...` separadas por vírgula. Comparadas em tempo constante.
# Exemplo: nxa_live_...,nxa_test_...
COMPAT_API_KEYS=
COMPAT_API_KEY_RATE_PER_MIN=60

# SOMENTE desenvolvimento. Em ENVIRONMENT=production a API recusa iniciar
# com qualquer um dos dois habilitado.
COMPAT_ALLOW_ANONYMOUS=false
COMPAT_OLLAMA_ALLOW_LOCALHOST=false

# Versão mínima aceita no header `anthropic-version`.
COMPAT_ANTHROPIC_VERSION=2023-06-01

# ===========================================================================
# APÊNDICE — variáveis apenas do Docker Compose (não lidas pela API)
# ===========================================================================
# O compose substitui OLLAMA_URL por DOCKER_OLLAMA_URL para que o contêiner
# alcance o Ollama do host (padrão: http://host.docker.internal:11434).
# O alvo `make docker-up-ollama` usa http://ollama:11434.
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434
