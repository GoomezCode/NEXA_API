# ---------------------------------------------------------------------------
# Nexa API - exemplo de configuração (12-factor / RNF-POR-02)
# Copie para .env e ajuste. NUNCA versione o .env.
# ---------------------------------------------------------------------------

# Ambiente: development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Autenticação do administrador (obrigatório) ---------------------------
ADMIN_USERNAME=admin
# Hash argon2id ou bcrypt. Gere com: python scripts/hash_password.py "sua-senha"
# O valor abaixo corresponde à senha "admin" e serve APENAS para desenvolvimento.
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$KMwCxpCk5TYd4cdcRrnSFA$QKtV/j4myVFG6IfaM7tR6yZnx4KqRu4Q+PtQA958h48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes-ou-mais
JWT_ALGORITHM=HS256
ADMIN_TOKEN_EXPIRE_MINUTES=60

# --- Convidados (guest) -----------------------------------------------------
GUEST_TOKEN_EXPIRE_HOURS=24
GUEST_DAILY_MESSAGES=10
GUEST_RATE_PER_MIN=3
GUEST_MAX_MESSAGES_PER_REQUEST=20
GUEST_MAX_MESSAGE_CHARS=2000
GUEST_IP_DAILY_MESSAGES=30
GUEST_TOKENS_PER_IP_PER_HOUR=10

# --- Limites do administrador ----------------------------------------------
RATE_LIMIT_ADMIN_CHAT_PER_MIN=60
MAX_MESSAGES_PER_REQUEST=100
MAX_MESSAGE_CHARS=8000
ALLOW_CLIENT_SYSTEM_MESSAGES=false
DEFAULT_SYSTEM_PROMPT=

# --- Segurança / entrada ----------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MAX_REQUEST_BODY_BYTES=2097152
# CIDRs de proxies confiáveis para ler X-Forwarded-For (vazio = não confiar)
TRUSTED_PROXIES=
CORS_ORIGINS=http://localhost:5173
UVICORN_WORKERS=1
# Prazo máximo do graceful shutdown (SIGTERM), em segundos (RNF-CON-04)
SHUTDOWN_TIMEOUT_SECONDS=30

# --- Provedor de IA ---------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
CLOUD_PROVIDER=
CLOUD_BASE_URL=
CLOUD_MODEL=
CLOUD_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_STREAM_IDLE_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_OUTPUT_SECONDS=300

# --- Redis (opcional; obrigatório se UVICORN_WORKERS > 1) -------------------
REDIS_URL=
